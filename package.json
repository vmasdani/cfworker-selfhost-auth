{
	"name": "cfworker-selfhost-auth",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"installer"
	],
	"scripts": {
		"test": "bun test",
		"typecheck": "bun run --filter '*' typecheck",
		"dev:tumbler": "bun run --cwd apps/tumbler dev",
		"build:tumbler": "bun run --cwd apps/tumbler build",
		"dev:coffer": "bun run --cwd apps/coffer dev",
		"build:coffer": "bun run --cwd apps/coffer build",
		"build:standalone": "bun run --cwd apps/tumbler build:standalone && bun run --cwd apps/coffer build:standalone",
		"start:tumbler": "bun run --cwd apps/tumbler start",
		"start:coffer": "bun run --cwd apps/coffer start"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
