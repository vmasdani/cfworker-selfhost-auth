# Standalone mode (bun run start / pm2). Copy to .env; Bun loads it from this directory.
# Every value is optional. Full reference: packages/standalone/src/server.ts
# PUBLIC_URL=https://app.example.com
# PORT=
# HOST=127.0.0.1
# DATA_DIR=./data
# TRUST_PROXY=1
# CLIENT_IP_HEADER=CF-Connecting-IP
# SERVER_SECRET is generated into DATA_DIR/server-secret on first start. To set it here instead
# (openssl rand -base64 32), do it before the first start and never change it afterwards.
# SERVER_SECRET=
